// Cloudflare deployment. See "Deploying to Cloudflare" in ARCHITECTURE.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concert-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Without this, every deploy erases plain-text variables set in the
  // dashboard (MULTI_USER, ACCESS_TEAM_DOMAIN, ACCESS_AUD). Keep them.
  "keep_vars": true,
  // Express, supabase-js and node:crypto need the Node.js APIs; this also
  // fills process.env from the vars and secrets below.
  "compatibility_flags": ["nodejs_compat"],
  // Needs charliechonguyen.com to be a zone on the same Cloudflare account;
  // the DNS record and certificate are created on deploy.
  "routes": [{ "pattern": "concert.charliechonguyen.com", "custom_domain": true }],
  // Builds the frontend first, so a bare `wrangler deploy` (or Workers Builds
  // from GitHub) always ships a fresh dist/.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    // Unknown addresses get public/404.html (dist/404.html), not the app.
    "not_found_handling": "404-page",
    // The Worker's ASSETS binding serves the pages it lets through (see
    // worker/index.ts). The share page (/s/<code>) and the old app addresses
    // are answered by the Worker before any static file, in either case of "s".
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/app", "/app.html", "/demo", "/unsubscribe", "/robots.txt", "/sitemap.xml", "/api/*", "/s", "/s/*", "/S", "/S/*"]
  },
  // ACCESS_TEAM_DOMAIN (https://<team>.cloudflareaccess.com) and ACCESS_AUD
  // (the Access application's audience tag) turn on the Worker's own check of
  // the Access sign-in token on every request except the share page. /api needs
  // them: without them, every /api request gets 503. OWNER_EMAIL (secret or
  // var) is the one sign-in allowed in single-owner mode (MULTI_USER not "on").
  "vars": {
    "NODE_ENV": "production",
    "GEMINI_EXTRACTION_MODEL": "gemini-flash-lite-latest",
    "GEMINI_DAILY_LIMIT": "50",
    "GEMINI_PER_MINUTE": "10",
    // Google Search grounding has no free-tier quota on this key (every call
    // returns 429). Turn on once billing is enabled for the Gemini project.
    "GEMINI_SEARCH_DISCOVERY": "off",
    "SOURCE_CACHE": "on",
    "CLASHFINDER_HASH_FORMAT": "{username}{privateKey}",
    // Where Google sends you back after "Connect Gmail".
    "APP_URL": "https://concert.charliechonguyen.com"
  },
  // Secrets (wrangler secret put): GEMINI_API_KEY, SUPABASE_URL,
  // SUPABASE_SERVICE_ROLE_KEY, CONTACT_EMAIL, TICKETMASTER_API_KEY,
  // SETLISTFM_API_KEY, BRAVE_SEARCH_API_KEY, CLASHFINDER_USERNAME, CLASHFINDER_PUBLIC_KEY or
  // CLASHFINDER_PRIVATE_KEY, IMPORT_TOKEN,
  // GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (Check email),
  // RESEND_API_KEY and EMAIL_UNSUBSCRIBE_SECRET (email notifications; optional EMAIL_FROM var).
  "queues": {
    "producers": [{ "binding": "LOOKUP_QUEUE", "queue": "concert-tracker-lookups" }],
    "consumers": [
      {
        "queue": "concert-tracker-lookups",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "concert-tracker-lookups-dlq"
      }
    ]
  },
  "triggers": { "crons": ["* * * * *"] },
  // Pull-request previews (Workers Builds runs `wrangler preview`). They get
  // the same plain settings but none of the secrets above, so a preview shows
  // the interface while its /api answers "not configured" and never touches
  // the Supabase data. Previews have no queue binding so they can never send
  // messages to the production queue.
  "previews": {
    "vars": {
      "NODE_ENV": "production",
      "GEMINI_EXTRACTION_MODEL": "gemini-flash-lite-latest",
      "GEMINI_DAILY_LIMIT": "50",
      "GEMINI_PER_MINUTE": "10",
      "GEMINI_SEARCH_DISCOVERY": "off",
      "CLASHFINDER_HASH_FORMAT": "{username}{privateKey}"
    }
  },
  "observability": { "enabled": true }
}
