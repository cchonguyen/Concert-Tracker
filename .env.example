# GEMINI_API_KEY: Gemini key. The reader only extracts names from pages the app
# fetched; without it, structured sources still work. A prepaid balance with
# auto top-up off is the outer spend wall. The local recall CLI also reads it.
# On Cloudflare, set keys with `npx wrangler secret put NAME` instead of this file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model used for extraction (code default: gemini-3.5-flash-lite). Pin a
# dated or versioned model; "-latest" names are refused when READER_PROVIDER is set.
GEMINI_EXTRACTION_MODEL="gemini-3.5-flash-lite"

# Guarded reader (src/server/reader/). Every model call goes through it.
# Provider: "gemini" (default) or "workers-ai". Workers AI is a gated option
# that is not built yet; leave this unset or "gemini" for now.
# READER_PROVIDER="gemini"
# Kill switch: unset or "on" lets calls through; any other value blocks them.
# READER_ENABLED="on"
# MINIMAL, LOW, MEDIUM, HIGH or OFF (default LOW).
# READER_THINKING_LEVEL="LOW"
# A page longer than this many characters is skipped, never cut up (default 30000).
# READER_MAX_INPUT_CHARS="30000"
# Characters read per call (default 30000).
# READER_WINDOW_CHARS="30000"
# Circuit breaker: opens after this many failures (default 5), for this many minutes (default 30).
# READER_BREAKER_FAILURES="5"
# READER_BREAKER_COOLDOWN_MIN="30"
# Most reader calls one lookup job may make (default 6).
# READER_MAX_CALLS_PER_JOB="6"
# Estimated spend caps in US dollars (defaults 0.5 a day, 5 a month).
# READER_MAX_SPEND_DAY_USD="0.5"
# READER_MAX_SPEND_MONTH_USD="5"
# Output token caps: lineup reads (default 8192) and event details (default 1024).
# READER_MAX_OUTPUT_TOKENS="8192"
# READER_MAX_OUTPUT_TOKENS_DETAILS="1024"
# Workers AI model, used only once that provider is built (default @cf/zai-org/glm-4.7-flash).
# WORKERS_AI_MODEL="@cf/zai-org/glm-4.7-flash"

# Recall CLI (a local script; these are read from your shell, never by the Worker).
# Local only: GEMINI_API_KEY (above), CF_ACCOUNT_ID and CLOUDFLARE_API_TOKEN.
# CF_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# Self-imposed call budget. Set these at or below the limits shown in AI Studio for the pinned model.
GEMINI_DAILY_LIMIT="50"
GEMINI_PER_MINUTE="10"
# "off" disables grounded search for lineup URLs when no source found anything.
# Search grounding needs billing on the Gemini project; unbilled keys get 429.
GEMINI_SEARCH_DISCOVERY="on"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Contact address sent in the User-Agent (MusicBrainz requires one).
CONTACT_EMAIL="you@example.com"

# Clashfinder (https://clashfinder.com/pages/api/): free account. Either set a
# ready-made public key, or the private key plus the hash format from the API page.
CLASHFINDER_USERNAME=""
CLASHFINDER_PUBLIC_KEY=""
CLASHFINDER_PRIVATE_KEY=""
CLASHFINDER_HASH_FORMAT="{username}{privateKey}"

# Ticketmaster Discovery API (https://developer.ticketmaster.com): free key, 5,000 calls/day.
# Used for event details (stage 1) and lineups (stage 2).
TICKETMASTER_API_KEY=""

# setlist.fm API (https://api.setlist.fm): free non-commercial key. Finds past
# shows by artist and date (stage 1) and confirms who performed (stage 2).
SETLISTFM_API_KEY=""

# Brave Search API (https://brave.com/search/api/): web search for lineup pages
# when no source lists an event. Preferred over Gemini grounded search.
BRAVE_SEARCH_API_KEY=""

# Email import: a long random string. Whoever posts ticket emails to
# /api/imports/email sends it as "Authorization: Bearer <token>". Unset, email
# import is off. Needs supabase/migrations/0004_email_imports.sql on Supabase.
IMPORT_TOKEN=""

# Check email: a Google Cloud OAuth web client (Gmail API on, gmail.readonly
# scope, redirect URI <APP_URL>/api/gmail/callback, published "In production").
# Unset, the Check email button is hidden. Needs 0006_app_settings.sql.
# The same client signs in to Google Sheets for the Table's sheet sync; turn
# on the Google Sheets API in the same project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Multi-user Sheets: 32 random bytes in base64 (openssl rand -base64 32) seals each member's Google token.
SHEETS_TOKEN_ENC_KEY=""
# Google file picker for members choosing an existing sheet (public key; project number).
GOOGLE_PICKER_API_KEY=""
GOOGLE_APP_ID=""
# The site's address, for Google's redirect (defaults to the request's host).
APP_URL="http://localhost:3000"

# SUPABASE_URL: URL of your Supabase PostgreSQL project. Apply
# supabase/migrations/0002_source_first_lineups.sql and 0003_event_log.sql
# before first use.
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Service role key for backend database access and migrations
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Lineup store: unset = Supabase when configured, else a local file store.
# "file" forces the local store; DATA_DIR sets where it lives (default ./data).
LINEUP_STORE=""
DATA_DIR=""

# Who may use /api. Unless MULTI_USER="on", only the Access sign-in in OWNER_EMAIL
# gets in. Missing settings close /api (503), so both ACCESS_* values are needed.
OWNER_EMAIL=""
# Local development only: "on" lets this machine use /api from the Node dev server
# with no Access sign-in. Ignored in production; the server listens on 127.0.0.1 only.
LOCAL_DEV_OWNER=""

# Multi-user (off unless MULTI_USER="on"; needs migrations 0017 and 0018 first,
# and ACCESS_TEAM_DOMAIN / ACCESS_AUD). SUPABASE_ANON_KEY and SUPABASE_JWT_SECRET
# are in Supabase > Project Settings > API. See ARCHITECTURE.md, "Multi-user".
MULTI_USER=""
SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""
# Gemini calls a day per member, and calls kept back for the owner (0 = no limit).
# Recommended with MULTI_USER=on: 5 interactive calls per member, 20 kept for the owner.
GEMINI_USER_DAILY="5"
GEMINI_OWNER_RESERVE="20"
# Background (backfill) calls a day per member. Recommended with MULTI_USER=on: 3.
GEMINI_USER_BACKFILL_DAILY="3"

# Keep Ticketmaster responses for 24 hours (shared by all members). Brave is never cached.
# SOURCE_CACHE=on

# Email notifications (Resend REST API, optional): invite emails, approval/welcome
# emails, and a max-1-daily access request digest for the owner. Without
# RESEND_API_KEY, email sending is skipped.
RESEND_API_KEY=""
EMAIL_FROM="LiveArchive <notifications@mail.charliechonguyen.com>"
EMAIL_UNSUBSCRIBE_SECRET=""
